<Project>
    <Target Name="MergeReactUI" AfterTargets="Build">
        <ItemGroup>
            <MergeInput Include="$(TargetPath)" />
            <MergeInput Include="$(MSBuildProjectDirectory)/../packages.local/ReactUI.dll" />
            <ILRepackSearchDir Include="@(ReferencePath->'%(RootDir)%(Directory)')" />
        </ItemGroup>
        <MakeDir Directories="$(TargetDir)ilrepack_tmp" />
        <!-- RenameInternalized avoids clashing with a pre-existing reactui dll that may be used from another mod -->
        <ILRepack InputAssemblies="@(MergeInput)" LibraryPath="@(ILRepackSearchDir)" TargetKind="SameAsPrimaryAssembly" OutputFile="$(TargetDir)ilrepack_tmp/$(TargetFileName)" Internalize="true" RenameInternalized="true" />
        <Delete Files="$(TargetPath)" />
        <Move SourceFiles="$(TargetDir)ilrepack_tmp/$(TargetFileName)" DestinationFiles="$(TargetPath)" />
        <RemoveDir Directories="$(TargetDir)ilrepack_tmp" />
    </Target>
</Project>
