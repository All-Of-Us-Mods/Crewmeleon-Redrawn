<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <DebugType>embedded</DebugType>

        <VersionPrefix>1.0.0</VersionPrefix>
        <VersionSuffix>dev</VersionSuffix>
        <Description>Mod generated using Reactor Template</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.735" Private="false" ExcludeAssets="runtime;native" />
        <PackageReference Include="BepInEx.IL2CPP.MSBuild" Version="2.1.0-rc.1" PrivateAssets="all" ExcludeAssets="runtime" />
        <PackageReference Include="BepInEx.AutoPlugin" Version="1.1.0" PrivateAssets="all" />

        <PackageReference Include="AmongUs.GameLibs.Steam" Version="2026.6.5" PrivateAssets="all" />
        <PackageReference Include="Reactor" Version="2.5.1-ci.384" />
    </ItemGroup>

    <!-- Opt-in brush system: -p:BRUSHES=true. Without it everyone paints with the circle brush
         and the picker UI is gone, but the shape/mask model, rasteriser and RPC stay compiled so
         a default build still renders strokes made with other brushes. -->
    <PropertyGroup Condition="'$(BRUSHES)' == 'true'">
        <DefineConstants>$(DefineConstants);BRUSHES</DefineConstants>
    </PropertyGroup>

    <ItemGroup Condition="'$(BRUSHES)' != 'true'">
        <Compile Remove="UI\BrushCreator.cs" />
        <Compile Remove="Components\BrushLibrary.cs" />
        <Compile Remove="Components\BrushPreset.cs" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Resources\**\*.*" />
        <Reference Include="MiraAPI">
            <HintPath>../packages.local\MiraAPI.dll</HintPath>
        </Reference>
        <Reference Include="ReactUI">
            <HintPath>../packages.local\ReactUI.dll</HintPath>
        </Reference>
    </ItemGroup>

    <Target Name="Copy" AfterTargets="Build" Condition="'$(AmongUs)' != ''">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AmongUs)/BepInEx/plugins/" UseSymboliclinksIfPossible="true" />
    </Target>

</Project>
